{
	"name": "@codeeditorland/jupyter-lsp-middleware",
	"version": "0.0.1",
	"private": false,
	"description": "VS Code Python Language Server Middleware for Jupyter Notebook",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandJupyterLSPMiddleware#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandJupyterLSPMiddleware/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandJupyterLSPMiddleware.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "dist/node/index.js",
	"types": "dist/node/index.d.ts",
	"scripts": {
		"buildTests": "npm run download-api && npm run copyTestAssets && npm run compilewatch",
		"compile": "tsc -p ./",
		"compilewatch": "tsc -watch -p ./",
		"copyTestAssets": "node ./scripts/prepareTest.js",
		"download-api": "vscode-dts dev",
		"postdownload-api": "vscode-dts main",
		"prepare": "npm run download-api",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"webpack": "webpack --mode production && node ./scripts/optimizeTypings.js",
		"webpack-dev": "webpack --mode development --watch",
		"webpack-link": "webpack --mode development && node ./scripts/optimizeTypings.js"
	},
	"dependencies": {
		"fast-myers-diff": "3.2.0",
		"sha.js": "2.4.11"
	},
	"devDependencies": {
		"@playform/build": "0.2.1",
		"@types/chai": "5.0.1",
		"@types/fs-extra": "11.0.4",
		"@types/glob": "8.1.0",
		"@types/node": "22.13.9",
		"@types/sha.js": "2.4.4",
		"@types/sinon": "17.0.4",
		"@types/tmp": "0.2.6",
		"@types/uuid": "10.0.0",
		"chai": "5.2.0",
		"fs-extra": "11.3.0",
		"glob": "11.0.1",
		"screenshot-desktop": "1.15.1",
		"sinon": "19.0.2",
		"tmp": "0.2.3",
		"ts-loader": "9.5.2",
		"uuid": "11.1.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"enabledApiProposals": [
		"notebookEditorEdit",
		"notebookEditor"
	],
	"overrides": {
		"terser@<5.14.2": "5.14.2"
	}
}
